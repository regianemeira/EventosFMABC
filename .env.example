# Copie este arquivo para .env e preencha antes de iniciar.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa-e-segura
ADMIN_EMAIL=eventos@fmabc.br
# Senha inicial da conta administrativa: mínimo de 6 caracteres
ADMIN_PASSWORD=
# Em HTTPS de produção, defina COOKIE_SECURE=1
COOKIE_SECURE=0
# Opcional: caminho absoluto para o banco SQLite
# DATABASE_PATH=/caminho/persistente/fmabc_eventos.db

# Para usar PostgreSQL (ex.: Neon, grátis) em vez do arquivo SQLite local,
# defina DATABASE_URL com a connection string fornecida pelo provedor.
# Quando preenchida, tem prioridade sobre DATABASE_PATH e o sistema passa a
# gravar tudo no PostgreSQL. Deixe em branco para continuar usando SQLite.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Envio mensal de comunicados por e-mail (configurar com a TI antes do uso real)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# URL acessível aos destinatários. Necessária para links de avaliação e confirmação de áreas após publicação.
APP_BASE_URL=

# Lembretes diários (tarefas vencendo, áreas pendentes, solicitantes sem resposta).
# 1 = gerar automaticamente a partir das 7h enquanto o sistema estiver ligado; 0 = desligado.
LEMBRETES_AUTOMATICOS=1
